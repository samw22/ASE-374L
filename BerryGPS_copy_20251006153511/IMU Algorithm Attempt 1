// ============================================================
// IMU-controlled payload fin stabilization (Arduino Uno)
// Using LSM6DSL + 4 servos for fins
// Author: Zeynep + GPT-5  (2025)
// ============================================================

#include <Wire.h>
#include <Servo.h>
#include <math.h>

// ---------------- USER CONFIG ----------------
#define LSM6DSL_ADDR 0x6A
#define CTRL1_XL     0x10
#define CTRL2_G      0x11
#define OUTX_L_G     0x22
#define OUTX_L_XL    0x28

const int SAMPLE_HZ = 100;
const float dt = 1.0f / SAMPLE_HZ;

// Servo pin mapping (adjust as needed)
const int PIN_SERVO_FRONT = 9;
const int PIN_SERVO_BACK  = 3;
const int PIN_SERVO_LEFT  = 12;
const int PIN_SERVO_RIGHT = 13;

const int SERVO_NEUTRAL = 90;
const int SERVO_MIN = 0;
const int SERVO_MAX = 180;

// PID gains
float Kp_roll = 4.0, Ki_roll = 0.2, Kd_roll = 0.08;
float Kp_pitch = 4.0, Ki_pitch = 0.2, Kd_pitch = 0.08;

const float MAX_DEFLECTION_DEG = 25.0;

// Madgwick filter parameter
const float BETA = 0.1f;

// ---------------- GLOBALS ----------------
Servo servoFront, servoBack, servoLeft, servoRight;

float q0 = 1.0f, q1 = 0.0f, q2 = 0.0f, q3 = 0.0f;

struct PID {
  float Kp, Ki, Kd;
  float integrator, prev_error, output_limit;
  float update(float e, float dt) {
    integrator += e * dt;
    float de = (e - prev_error) / dt;
    prev_error = e;
    float out = Kp * e + Ki * integrator + Kd * de;
    if (out > output_limit) out = output_limit;
    if (out < -output_limit) out = -output_limit;
    return out;
  }
} pidRoll, pidPitch;

// ---------------- IMU setup ----------------
void writeRegister(byte reg, byte val) {
  Wire.beginTransmission(LSM6DSL_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

int16_t read16(byte reg) {
  Wire.beginTransmission(LSM6DSL_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom(LSM6DSL_ADDR, 2);
  int16_t val = Wire.read() | (Wire.read() << 8);
  return val;
}

void imuInit() {
  Wire.begin();
  writeRegister(CTRL1_XL, 0x40); // accel 104Hz
  writeRegister(CTRL2_G, 0x40);  // gyro 104Hz
}

// ---------------- Madgwick filter ----------------
inline float deg2rad(float d) { return d * M_PI / 180.0f; }
inline float rad2deg(float r) { return r * 180.0f / M_PI; }

void MadgwickUpdate(float gx, float gy, float gz, float ax, float ay, float az, float dt) {
  float gx_r = deg2rad(gx);
  float gy_r = deg2rad(gy);
  float gz_r = deg2rad(gz);

  float recipNorm;
  float s0, s1, s2, s3;
  float qDot1, qDot2, qDot3, qDot4;
  float _2q0 = 2.0f * q0;
  float _2q1 = 2.0f * q1;
  float _2q2 = 2.0f * q2;
  float _2q3 = 2.0f * q3;
  float _4q0 = 4.0f * q0;
  float _4q1 = 4.0f * q1;
  float _4q2 = 4.0f * q2;
  float q0q0 = q0 * q0;
  float q1q1 = q1 * q1;
  float q2q2 = q2 * q2;
  float q3q3 = q3 * q3;

  recipNorm = sqrt(ax * ax + ay * ay + az * az);
  if (recipNorm == 0.0f) return;
  recipNorm = 1.0f / recipNorm;
  ax *= recipNorm;
  ay *= recipNorm;
  az *= recipNorm;

  s0 = _4q0 * q2q2 + _2q2 * ax + _4q0 * q1q1 - _2q1 * ay;
  s1 = _4q1 * q3q3 - _2q3 * ax + 4.0f * q0q0 * q1 - _2q0 * ay - _4q1 + _8q1 * q1q1 + _8q1 * q2q2 + _4q1 * az;
  s2 = 4.0f * q0q0 * q2 + _2q0 * ax + _4q2 * q3q3 - _2q3 * ay - _4q2 + _8q2 * q1q1 + _8q2 * q2q2 + _4q2 * az;
  s3 = 4.0f * q1q1 * q3 - _2q1 * ax + 4.0f * q2q2 * q3 - _2q2 * ay;
  float normS = sqrt(s0*s0 + s1*s1 + s2*s2 + s3*s3);
  if (normS == 0.0f) return;
  s0 /= normS; s1 /= normS; s2 /= normS; s3 /= normS;

  qDot1 = 0.5f * (-q1 * gx_r - q2 * gy_r - q3 * gz_r) - BETA * s0;
  qDot2 = 0.5f * (q0 * gx_r + q2 * gz_r - q3 * gy_r) - BETA * s1;
  qDot3 = 0.5f * (q0 * gy_r - q1 * gz_r + q3 * gx_r) - BETA * s2;
  qDot4 = 0.5f * (q0 * gz_r + q1 * gy_r - q2 * gx_r) - BETA * s3;

  q0 += qDot1 * dt;
  q1 += qDot2 * dt;
  q2 += qDot3 * dt;
  q3 += qDot4 * dt;

  recipNorm = 1.0f / sqrt(q0*q0 + q1*q1 + q2*q2 + q3*q3);
  q0 *= recipNorm;
  q1 *= recipNorm;
  q2 *= recipNorm;
  q3 *= recipNorm;
}

void quaternionToEuler(float &roll, float &pitch) {
  float sinr_cosp = 2.0f * (q0 * q1 + q2 * q3);
  float cosr_cosp = 1.0f - 2.0f * (q1*q1 + q2*q2);
  roll = rad2deg(atan2(sinr_cosp, cosr_cosp));

  float sinp = 2.0f * (q0 * q2 - q3 * q1);
  if (fabs(sinp) >= 1)
    pitch = rad2deg(copysign(M_PI / 2, sinp));
  else
    pitch = rad2deg(asin(sinp));
}

int deflectionToServoAngle(float defl_deg) {
  float angle = SERVO_NEUTRAL + defl_deg;
  if (angle > SERVO_MAX) angle = SERVO_MAX;
  if (angle < SERVO_MIN) angle = SERVO_MIN;
  return (int)angle;
}

// ---------------- MAIN ----------------
void setup() {
  Serial.begin(115200);
  imuInit();

  servoFront.attach(PIN_SERVO_FRONT);
  servoBack.attach(PIN_SERVO_BACK);
  servoLeft.attach(PIN_SERVO_LEFT);
  servoRight.attach(PIN_SERVO_RIGHT);

  servoFront.write(SERVO_NEUTRAL);
  servoBack.write(SERVO_NEUTRAL);
  servoLeft.write(SERVO_NEUTRAL);
  servoRight.write(SERVO_NEUTRAL);

  pidRoll.Kp = Kp_roll; pidRoll.Ki = Ki_roll; pidRoll.Kd = Kd_roll; pidRoll.output_limit = MAX_DEFLECTION_DEG;
  pidPitch.Kp = Kp_pitch; pidPitch.Ki = Ki_pitch; pidPitch.Kd = Kd_pitch; pidPitch.output_limit = MAX_DEFLECTION_DEG;

  Serial.println("LSM6DSL AHRS stabilization running...");
  delay(200);
}

void loop() {
  // --- 1. Read IMU ---
  int16_t gx = read16(OUTX_L_G);
  int16_t gy = read16(OUTX_L_G + 2);
  int16_t gz = read16(OUTX_L_G + 4);
  int16_t ax = read16(OUTX_L_XL);
  int16_t ay = read16(OUTX_L_XL + 2);
  int16_t az = read16(OUTX_L_XL + 4);

  // Convert to physical units
  float ax_g = ax * 0.000061;
  float ay_g = ay * 0.000061;
  float az_g = az * 0.000061;
  float gx_dps = gx * 0.00875;
  float gy_dps = gy * 0.00875;
  float gz_dps = gz * 0.00875;

  // --- 2. Madgwick filter ---
  MadgwickUpdate(gx_dps, gy_dps, gz_dps, ax_g, ay_g, az_g, dt);

  // --- 3. Roll/pitch estimation ---
  float roll, pitch;
  quaternionToEuler(roll, pitch);

  // --- 4. PID control ---
  float err_roll = -roll;
  float err_pitch = -pitch;
  float defl_roll = pidRoll.update(err_roll, dt);
  float defl_pitch = pidPitch.update(err_pitch, dt);

  // --- 5. Mix to fins ---
  float front_defl = -defl_pitch;
  float back_defl  = defl_pitch;
  float left_defl  = defl_roll;
  float right_defl = -defl_roll;

  // --- 6. Write to servos ---
  servoFront.write(deflectionToServoAngle(front_defl));
  servoBack.write(deflectionToServoAngle(back_defl));
  servoLeft.write(deflectionToServoAngle(left_defl));
  servoRight.write(deflectionToServoAngle(right_defl));

  // --- 7. Print telemetry ---
  static unsigned long lastPrint = 0;
  if (millis() - lastPrint > 200) {
    lastPrint = millis();
    Serial.print("R: "); Serial.print(roll, 2);
    Serial.print(" P: "); Serial.print(pitch, 2);
    Serial.print(" | F: "); Serial.print(front_defl, 1);
    Serial.print(" B: "); Serial.print(back_defl, 1);
    Serial.print(" L: "); Serial.print(left_defl, 1);
    Serial.print(" R: "); Serial.println(right_defl, 1);
  }

  delay(10);
}
