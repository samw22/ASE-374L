#include <Wire.h>
#include <Servo.h>
#include <TinyGPSPlus.h>
#include <Adafruit_BNO055.h>
#include <Adafruit_Sensor.h>

// ======= GPS and IMU setup =======
TinyGPSPlus gps;
Adafruit_BNO055 bno = Adafruit_BNO055(55);

// ======= Servo pins =======
Servo rollServo;
Servo pitchServo;
Servo yawServo;

// ======= Control gains =======
float kRoll = 2.0;
float kPitch = 2.0;
float kYaw = 1.0;

// ======= Adaptive tuning =======
float prevDistance = 0;
float improvementTol = 2.0;     // meters — how much closer it must get to count as improvement
unsigned long lastAdaptTime = 0;
unsigned long adaptInterval = 3000;  // every 3 seconds

// ======= Target =======
float targetLat = 37.7749;  // Example coordinates
float targetLon = -122.4194;

// ======= State =======
bool haveFix = false;
bool descentMode = false;

// ======= Utility functions =======
float getDistance(float lat1, float lon1, float lat2, float lon2) {
  float R = 6371000.0; // Earth radius (m)
  float dLat = radians(lat2 - lat1);
  float dLon = radians(lon2 - lon1);
  float a = sin(dLat / 2) * sin(dLat / 2) +
            cos(radians(lat1)) * cos(radians(lat2)) *
            sin(dLon / 2) * sin(dLon / 2);
  float c = 2 * atan2(sqrt(a), sqrt(1 - a));
  return R * c;
}

float getBearing(float lat1, float lon1, float lat2, float lon2) {
  float dLon = radians(lon2 - lon1);
  float y = sin(dLon) * cos(radians(lat2));
  float x = cos(radians(lat1)) * sin(radians(lat2)) -
            sin(radians(lat1)) * cos(radians(lat2)) * cos(dLon);
  float brng = degrees(atan2(y, x));
  return fmod((brng + 360.0), 360.0);
}

// ======= Setup =======
void setup() {
  Serial.begin(9600);
  Wire.begin();

  rollServo.attach(3);
  pitchServo.attach(5);
  yawServo.attach(6);

  if (!bno.begin()) {
    Serial.println("IMU not detected!");
    while (1);
  }

  Serial.println("System starting...");
}

// ======= Main Loop =======
void loop() {
  // --- GPS update (replace with your actual serial GPS input) ---
  while (Serial.available() > 0) gps.encode(Serial.read());
  if (gps.location.isValid()) haveFix = true;

  if (!haveFix) return;

  // --- Read sensors ---
  sensors_event_t orientationData;
  bno.getEvent(&orientationData);
  float yaw = orientationData.orientation.x;
  float pitch = orientationData.orientation.y;
  float roll = orientationData.orientation.z;

  // --- Calculate navigation errors ---
  float currentLat = gps.location.lat();
  float currentLon = gps.location.lng();

  float distanceToTarget = getDistance(currentLat, currentLon, targetLat, targetLon);
  float targetBearing = getBearing(currentLat, currentLon, targetLat, targetLon);
  float yawError = targetBearing - yaw;
  if (yawError > 180) yawError -= 360;
  if (yawError < -180) yawError += 360;

  // --- Determine control mode ---
  if (distanceToTarget < 15.0) { // within 15 m of target
    descentMode = true;
  }

  // --- Adaptive gain adjustment (kPitch + kYaw) ---
  unsigned long now = millis();
  if (!descentMode && (now - lastAdaptTime > adaptInterval)) {

    bool gettingCloser = (distanceToTarget < prevDistance - improvementTol);

    if (!gettingCloser) {
      // Not improving → increase pitch gain (descend faster / more aggressive)
      kPitch += 0.2;
      if (abs(yawError) > 15) {
        // if pointing wrong direction, increase yaw gain slightly
        kYaw += 0.1;
      }
    } else {
      // Getting closer → gently decay gains
      kPitch -= 0.05;
      kYaw  -= 0.02;
    }

    // Clamp to safe limits
    kPitch = constrain(kPitch, 1.0, 6.0);
    kYaw   = constrain(kYaw, 0.5, 3.0);

    prevDistance = distanceToTarget;
    lastAdaptTime = now;

    Serial.print("Adaptive gains → kPitch: ");
    Serial.print(kPitch);
    Serial.print(", kYaw: ");
    Serial.println(kYaw);
  }

  // --- Control law ---
  float yawCmd = constrain(kYaw * (yawError / 90.0), -1, 1);
  float pitchCmd = constrain(kPitch * (distanceToTarget / 100.0), -1, 1);

  // --- Descent stabilization ---
  if (descentMode) {
    // When close, reduce pitch and yaw corrections → go straight down
    pitchCmd = 0.6; // steady downward glide
    yawCmd *= 0.3;
    Serial.println("Descent mode active – stabilizing downward.");
  }

  // --- Apply to servos ---
  rollServo.write(90); // Keep level for now
  pitchServo.write(90 + pitchCmd * 30);
  yawServo.write(90 + yawCmd * 30);

  // --- Debug info ---
  Serial.print("Dist: ");
  Serial.print(distanceToTarget);
  Serial.print(" m | YawErr: ");
  Serial.print(yawError);
  Serial.print(" | PitchCmd: ");
  Serial.print(pitchCmd);
  Serial.print(" | YawCmd: ");
  Serial.println(yawCmd);

  delay(200);
}
