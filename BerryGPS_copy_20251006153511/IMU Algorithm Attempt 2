import numpy as np
import matplotlib.pyplot as plt

# --- Simulation parameters ---
dt = 0.01         # time step (s)
T = 10.0          # total time (s)
steps = int(T / dt)

# --- Physical parameters ---
I = 0.02          # moment of inertia (kg·m²)
K_aero = 0.1      # aerodynamic damping
K_fin = 0.05      # torque per deg of fin deflection
g = 9.81          # gravity (m/s²)

# --- PID gains ---
Kp, Ki, Kd = 3.0, 0.3, 0.05

# --- Initialize state ---
theta = 20.0      # tilt angle (degrees)
omega = 0.0       # angular velocity (deg/s)
int_err = 0.0
prev_err = 0.0

# --- Logging ---
theta_log, fin_log = [], []

for i in range(steps):
    # --- IMU-like measurements ---
    # Gyroscope measures angular rate (deg/s)
    gyro_meas = omega + np.random.normal(0, 0.1)

    # Accelerometer measures gravity projection in g units
    # tilt of θ => measured acceleration = -sin(θ)
    accel_meas = -np.sin(np.radians(theta))  # in g

    # Estimate tilt angle (from accel only)
    theta_est = np.degrees(np.arcsin(-accel_meas))  # convert to deg

    # --- PID controller ---
    err = 0.0 - theta_est  # target = 0° (upright)
    int_err += err * dt
    deriv = (err - prev_err) / dt
    fin_defl = Kp * err + Ki * int_err + Kd * deriv
    prev_err = err

    # Limit fin movement
    fin_defl = np.clip(fin_defl, -20, 20)

    # --- Physics update ---
    # Fin creates torque; damping resists motion
    torque = -K_fin * fin_defl - K_aero * omega
    alpha = torque / I                  # angular acceleration (deg/s²)
    omega += alpha * dt                 # update angular velocity (deg/s)
    theta += omega * dt                 # update angle (deg)

    theta_log.append(theta)
    fin_log.append(fin_defl)

# --- Plot results ---
time = np.arange(steps) * dt
plt.figure(figsize=(10,5))
plt.subplot(2,1,1)
plt.plot(time, theta_log)
plt.ylabel("Tilt angle (°)")
plt.grid(True)
plt.subplot(2,1,2)
plt.plot(time, fin_log)
plt.ylabel("Fin deflection (°)")
plt.xlabel("Time (s)")
plt.grid(True)
plt.show()
